# ==========================================
# 1. Go 语言相关忽略项 (Go Standard)
# ==========================================
# 编译生成的二进制文件或可执行文件
/my-go-app
app
*.exe
*.exe~
*.dll
*.so
*.dylib

# 单元测试覆盖率报告
*.out
*.test
*.prof


# ==========================================
# 2. Terraform 相关忽略项 (Terraform Standard)
# ==========================================
# 忽略本地下载的云厂商驱动插件目录（巨大且无需版本控制，流水线会自动 init 下载）
.terraform/

# 💡 核心安全：绝对不要把本地的状态文件和备份推送到 Git
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.backup

# 忽略本地变量配置文件（里面可能含有你的个人测试密码/临时密钥）
*.tfvars
*.tfvars.json

# 忽略临时生成的执行计划文件（我们在流水线里生成的 tfplan 会在虚拟机销毁时自动消失）
tfplan
ftplan
*plan

# 忽略 Terraform 运行产生的崩溃日志
crash.log
crash.*.log


# ==========================================
# 3. 操作系统及本地开发工具相关 (OS & IDE)
# ==========================================
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
